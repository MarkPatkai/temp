{
  "name": "haven-foundation",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "browser": { "child_process": false, "fs": false, "path": false, "crypto": false, "url": false, "module": false },
  "engines": { "node": ">=24.15 <25" },
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --port 4200",
    "preview": "node scripts/serve-preview.mjs",
    "prestart": "npm run schemas:generate",
    "schemas:generate": "tsx scripts/generate-validators.ts",
    "build": "npm run schemas:generate && node scripts/copy-runtime.mjs && ng build",
    "typecheck": "npm run schemas:generate && tsc --noEmit && ngc -p apps/game/tsconfig.app.json --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "content:validate": "tsx scripts/validate-content.ts",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:e2e": "playwright test",
    "verify:scenario": "tsx scripts/verify-scenario.ts",
    "verify": "npm run check:boundaries && npm run typecheck && npm run content:validate && npm test && npm run build",
    "tauri:dev": "node scripts/copy-runtime.mjs && node scripts/tauri.mjs dev",
    "tauri:build": "node scripts/tauri.mjs build",
    "postinstall": "node scripts/copy-runtime.mjs"
  },
  "dependencies": {
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@sinclair/typebox": "^0.34.41",
    "@tauri-apps/api": "^2.10.1",
    "ajv": "8.20.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "wasmoon": "1.16.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@playwright/test": "1.65.0",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^24.10.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vitest": "5.1.0"
  }
}
