  {
    "id": "story:interaction.gate",
    "kind": "interaction",
    "name": "At the city gates",
    "schemaVersion": 1,
    "npcId": "story:character.officer",
    "locationId": "story:location.veybridge",
    "questId": "story:quest.stranger",
    "requires": [],
    "text": "Welcome to Crossroads. Whatever you were before you arrived, you are free to become someone else here.",
    "choices": [
      {
        "id": "register",
        "text": "Present your registration.",
        "response": "Your entry is recorded. The Guild Hall is across the square."
      }
    ]
  },
  {
    "id": "story:interaction.mara",
    "kind": "interaction",
    "name": "A home for those willing to build one",
    "schemaVersion": 1,
    "npcId": "story:character.mara",
    "locationId": "story:location.veybridge",
    "questId": "story:quest.stranger",
    "requires": [
      "story:interaction.gate"
    ],
    "text": "Welcome to the Adventurers\u2019 Guild. If you are here for the Open Charter, you are in the right place. You do not need to become a hero. First, find out what you can do.",
    "choices": [
      {
        "id": "settle",
        "text": "I want a place to settle.",
        "response": "A workshop, a farm, a home \u2014 the charter leaves that choice to you."
      },
      {
        "id": "adventure",
        "text": "I would like to become an adventurer.",
        "response": "Then we will help you prepare. There is more than one way to contribute."
      },
      {
        "id": "private",
        "text": "I am still deciding.",
        "response": "There is no need to choose your whole life today."
      }
    ]
  },
  {
    "id": "story:interaction.borin",
    "kind": "interaction",
    "name": "Read the fine print",
    "schemaVersion": 1,
    "npcId": "story:character.borin",
    "locationId": "story:location.veybridge",
    "questId": "story:quest.stranger",
    "requires": [
      "story:interaction.mara"
    ],
    "text": "A sword protects you from bandits. A properly registered deed protects you from everyone else. Briarfield has a damaged foundation, a neglected well and room to build. First, you must complete the Guild assessment.",
    "choices": [
      {
        "id": "rights",
        "text": "Ask about passage and existing land rights.",
        "response": "The charter respects existing property and passage rights. Unoccupied on a map does not always mean unused."
      },
      {
        "id": "assessment",
        "text": "Ask what the assessment involves.",
        "response": "Combat, craft, magic or exploration. Speak to the Guild when you are ready; your profession remains your choice."
      }
    ]
  },
